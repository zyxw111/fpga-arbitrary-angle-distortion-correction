(_flow fab_demo "2022.2-SP6.4"
    (_comment "Generated by Fabric Compiler (version on 2022.2-SP6.4<build 146967>) at Thu Oct  8 16:36:28 2026")
    (_version "1.1.0")
    (_status "initial")
    (_project 
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "build"))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos2)
                    (_device PG2L100H)
                    (_speedgrade -6)
                    (_package FBG484)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "rtl/aadcs_pcie_top.v" + "aadcs_pcie_top"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/fifo/ipm_distributed_sdpram_v1_2_distributed_fifo.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/fifo/pgs_pciex4_fifo_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/fifo/pgs_pciex4_fifo_v1_2.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ipm_distributed_sdpram_v1_2.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_expd_apb_mux.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_controller.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_cpld_tx_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_mrd_tx_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_mwr_tx_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_ram/ips2l_pcie_dma_ram.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_ram/rtl/ipm2l_sdpram_v1_1_ips2l_pcie_dma_ram.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_rd_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_rx_cpld_wr_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_rx_mwr_wr_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_rx_top.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_tlp_rcv.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_tlp_tx_mux.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_tx_cpld_rd_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_tx_mwr_rd_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_tx_top.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/ips2l_pcie_dma_wr_ctrl.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_dma/pgs_pciex4_prefetch_fifo_v1_2.v"
                    (_format verilog)
                )
                (_file "rtl/pcie_test_source.v"
                    (_format verilog)
                )
            )
        )
        (_widget wgt_my_ips_src
            (_input
                (_file "ip/pcie_test/pcie_test.idf" (_format idf))
            )
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "constraints/pcie_100h.fdc" (_format fdc))
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_simulation
        )
    )
    (_task tsk_compile
        (_command cmd_compile
            (_gci_state (_integer 4))
        )
        (_widget wgt_rtl_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_gci_state (_integer 4))
            (_option selected_syn_tool_opt (_integer 1))
        )
        (_widget wgt_tech_view
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_map_constraint
        )
        (_widget wgt_my_fic_src
        )
        (_widget wgt_inserter_gui_view
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap
            (_gci_state (_integer 4))
        )
        (_widget wgt_edit_placement_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_edit_route_cons
            (_attribute _click_to_run (_switch ON))
        )
    )
    (_task tsk_pnr
        (_command cmd_pnr
            (_gci_state (_integer 4))
        )
        (_widget wgt_power_calculator
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_timing_analysis
            (_attribute _click_to_run (_switch ON))
        )
        (_command cmd_report_post_pnr_timing
            (_gci_state (_integer 4))
            (_attribute _auto_exe_lock (_switch OFF))
        )
        (_widget wgt_arch_browser
            (_attribute _click_to_run (_switch ON))
        )
        (_command cmd_report_power
            (_gci_state (_integer 4))
            (_attribute _auto_exe_lock (_switch OFF))
            (_attribute _auto_exe (_switch OFF))
        )
        (_command cmd_gen_netlist
            (_gci_state (_integer 4))
            (_attribute _auto_exe_lock (_switch OFF))
            (_attribute _auto_exe (_switch OFF))
        )
    )
    (_task tsk_gen_bitstream
        (_command cmd_gen_bitstream
            (_gci_state (_integer 4))
        )
    )
)
