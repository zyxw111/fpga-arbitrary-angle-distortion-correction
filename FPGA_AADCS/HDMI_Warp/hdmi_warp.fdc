# hd_sda
define_attribute {p:hd_sda} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:hd_sda} {PAP_IO_LOC} {AA20}
define_attribute {p:hd_sda} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hd_sda} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hd_sda} {PAP_IO_DRIVE} {4}
define_attribute {p:hd_sda} {PAP_IO_SLEW} {FAST}

# hd_scl
define_attribute {p:hd_scl} {PAP_IO_DIRECTION} {INOUT}
define_attribute {p:hd_scl} {PAP_IO_LOC} {AA21}
define_attribute {p:hd_scl} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hd_scl} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hd_scl} {PAP_IO_DRIVE} {4}
define_attribute {p:hd_scl} {PAP_IO_SLEW} {FAST}
create_clock -name {hdmi_pclk} [get_ports {pixclk_in}] -period {6.734} -waveform {0 3.367}
set_clock_groups -asynchronous -group [get_clocks {hdmi_pclk}] -group [get_clocks {ref_clk board_ref125 rst_clk ddrphy_sysclk phy_dq_sysclk_0 phy_dq_sysclk_1 pclk pclk_div2 pcie_ref_clk}]
set_false_path -from [get_ports {hd_sda}]
set_false_path -to [get_ports {hd_scl hd_sda}]

# Diagnostic first-stage CDC only; functional paths remain timed.
set_false_path -to [get_cells -hierarchical {*debug_ddr_meta*}]
set_false_path -to [get_cells -hierarchical {*u_image/camera_ready_meta*}]

# HDMIK external I/O delays are unspecified; board-level sampling needs hardware validation.
set_false_path -from [get_cells -hierarchical {*control/held*}] -to [get_cells -hierarchical {*control/active_config* *control/active_generation*}]
set_false_path -to [get_cells -hierarchical {*control/ack_sync* *control/request_sync*}]
set_false_path -from [get_cells -hierarchical {*monitor_mailbox/held* *geometry_mailbox/held*}] -to [get_cells -hierarchical {*monitor_mailbox/dst_data* *geometry_mailbox/dst_data*}]
set_false_path -to [get_cells -hierarchical {*monitor_mailbox/src_release* *monitor_mailbox/dst_release* *geometry_mailbox/src_release* *geometry_mailbox/dst_release*}]
